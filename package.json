{
  "name": "@crazymoralfreak/openlens-prettylogs",
  "version": "0.1.0",
  "description": "Pretty log viewer for OpenLens: level filters, regex search, saved filters, JSON/XML/YAML pretty view and a realtime pop-out window",
  "license": "MIT",
  "private": false,
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "engines": {
    "node": ">=16.14.2",
    "lens": "^6.3.0"
  },
  "keywords": [
    "lens",
    "openlens",
    "extension",
    "kubernetes",
    "logs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crazymoralfreak/PrettyLogs.git"
  },
  "bugs": {
    "url": "https://github.com/Crazymoralfreak/PrettyLogs/issues"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && webpack",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@k8slens/extensions": "^6.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^18.19.0",
    "@types/react": "^17.0.52",
    "@types/react-dom": "^17.0.18",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.11.0",
    "eslint": "^8.57.0",
    "highlight.js": "^11.9.0",
    "js-yaml": "^4.1.0",
    "mobx": "^6.9.0",
    "mobx-react": "^7.6.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-virtuoso": "^4.7.0",
    "rimraf": "^5.0.5",
    "smol-toml": "^1.3.0",
    "sql-formatter": "^15.3.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^4.9.5",
    "vitest": "^2.1.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "xml-formatter": "^3.6.3"
  }
}
